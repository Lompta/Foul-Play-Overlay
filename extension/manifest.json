{
  "manifest_version": 3,
  "name": "Foul Play Overlay",
  "version": "0.2.0",
  "description": "What would Foul Play do? Move analysis for Showdown replays and unrated battles, plus a turn-by-turn review of your own finished games, from a local Foul Play server.",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8770/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Review my games (Foul Play)" },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*", "https://replay.pokemonshowdown.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.pokemonshowdown.com/*", "https://replay.pokemonshowdown.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
